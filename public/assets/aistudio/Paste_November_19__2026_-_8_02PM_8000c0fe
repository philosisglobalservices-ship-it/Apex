  (function initCalculator() {
    const slider = document.getElementById('deposit-slider');
    const displayAmount = document.getElementById('calc-display-amount');
    const displayReturn = document.getElementById('calc-display-return');
    const displayTotal = document.getElementById('calc-display-total');

    if (!slider || !displayAmount || !displayReturn || !displayTotal) return;

    const rate = 0.054; // 5.40%

    function updateCalculator() {
      const val = parseFloat(slider.value);
      const formattedPrincipal = new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD',
        maximumFractionDigits: 0
      }).format(val);

      const annualYield = val * rate;
      const total = val + annualYield;

      const formattedYield = new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD',
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      }).format(annualYield);

      const formattedTotal = new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD',
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      }).format(total);

      displayAmount.textContent = `${formattedPrincipal} USD`;
      displayReturn.textContent = `+${formattedYield}`;
      displayTotal.textContent = formattedTotal;
    }

    slider.addEventListener('input', updateCalculator);

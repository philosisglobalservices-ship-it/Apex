    (function initDepositFlow() {
      const input = document.getElementById('deposit-input');
      const ctaLabel = document.getElementById('cta-label');
      const breakdownPrincipal = document.getElementById('breakdown-principal');
      const breakdownLimit = document.getElementById('breakdown-limit');
      const quickChips = document.querySelectorAll('.quick-chip');
      const railCards = document.querySelectorAll('.rail-card');

      function formatNumber(num) {
        return num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      }

      function updateAmounts(val) {
        const cleanVal = Math.min(Math.max(val, 0), 250000);
        input.value = cleanVal.toLocaleString('en-US');
        ctaLabel.textContent = `Confirm & Deposit $${formatNumber(cleanVal)}`;
        breakdownPrincipal.textContent = `$${formatNumber(cleanVal)}`;
        
        const remaining = Math.max(250000 - cleanVal, 0);
        breakdownLimit.textContent = `$${formatNumber(remaining)} left`;
      }

      quickChips.forEach(chip => {
        chip.addEventListener('click', () => {
          quickChips.forEach(c => {
            c.classList.remove('bg-primary/15', 'text-primary', 'font-semibold');
            c.classList.add('bg-surface-container', 'text-on-surface');
          });
          chip.classList.remove('bg-surface-container', 'text-on-surface');
          chip.classList.add('bg-primary/15', 'text-primary', 'font-semibold');

          const amt = parseInt(chip.getAttribute('data-amt'), 10);
          updateAmounts(amt);
        });
      });

      input.addEventListener('input', (e) => {
        let raw = e.target.value.replace(/[^0-9]/g, '');
        let num = parseInt(raw, 10);
        if (isNaN(num)) num = 0;
        updateAmounts(num);
      });

      railCards.forEach(card => {
        card.addEventListener('click', () => {
          railCards.forEach(rc => {
            rc.classList.remove('bg-surface-container');
            rc.classList.add('bg-surface-container-high/60');
            const check = rc.querySelector('.rounded-full:last-child');
            if (check) {
              check.className = 'w-5 h-5 rounded-full bg-surface-container-highest flex items-center justify-center flex-shrink-0';
              check.innerHTML = '<span class="w-2 h-2 rounded-full bg-transparent"></span>';
            }
          });
          card.classList.remove('bg-surface-container-high/60');
          card.classList.add('bg-surface-container');
          const activeCheck = card.querySelector('.rounded-full:last-child');
          if (activeCheck) {
            activeCheck.className = 'w-5 h-5 rounded-full bg-primary flex items-center justify-center flex-shrink-0 text-on-primary';

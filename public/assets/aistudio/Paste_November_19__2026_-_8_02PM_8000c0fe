<script>
  let currentRole = 'client';

  function switchRole(role) {
    currentRole = role;
    const clientBtn = document.getElementById('role-client-btn');
    const adminBtn = document.getElementById('role-admin-btn');
    const kycCard = document.getElementById('client-kyc-card');
    const adminCard = document.getElementById('admin-security-card');
    const identityLabel = document.getElementById('identity-label');
    const emailInput = document.getElementById('email-input');
    const submitText = document.getElementById('submit-text');

    if (role === 'admin') {
      // Toggle button styles
      adminBtn.className = "flex-1 py-2.5 rounded-full font-title-md text-[13px] transition-all duration-300 flex items-center justify-center gap-1.5 bg-secondary-container text-on-secondary-container font-semibold shadow-md";
      clientBtn.className = "flex-1 py-2.5 rounded-full font-title-md text-[13px] transition-all duration-300 flex items-center justify-center gap-1.5 text-on-surface-variant hover:text-on-surface font-medium";

      // Toggle informational visual card
      kycCard.classList.add('hidden');
      adminCard.classList.remove('hidden');

      // Update Form Context
      identityLabel.innerHTML = '<span>Admin Directory Badge / ID</span><span class="text-secondary-fixed normal-case text-[11px] font-normal">Dual-Auth Required</span>';
      emailInput.value = 'sec-admin.vault7@apex-compliance.org';
      submitText.textContent = 'Verify Admin Credentials';
    } else {
      // Toggle button styles
      clientBtn.className = "flex-1 py-2.5 rounded-full font-title-md text-[13px] transition-all duration-300 flex items-center justify-center gap-1.5 bg-primary text-on-primary font-semibold shadow-md";
      adminBtn.className = "flex-1 py-2.5 rounded-full font-title-md text-[13px] transition-all duration-300 flex items-center justify-center gap-1.5 text-on-surface-variant hover:text-on-surface font-medium";

      // Toggle informational visual card
      adminCard.classList.add('hidden');
      kycCard.classList.remove('hidden');

      // Update Form Context
      identityLabel.innerHTML = '<span>Corporate Identity / Email</span><span class="text-primary normal-case text-[11px] font-normal">SSO Enabled</span>';
      emailInput.value = 'v.chen@apex-capital.io';
      submitText.textContent = 'Authenticate & Ingress';
    }
  }

  function togglePassVisibility() {
    const passInput = document.getElementById('password-input');
    const eyeIcon = document.getElementById('eye-icon');
    if (passInput.type === 'password') {
      passInput.type = 'text';
      eyeIcon.textContent = 'visibility_off';
    } else {
      passInput.type = 'password';
      eyeIcon.textContent = 'visibility';
    }
  }

  function calculateStrength(val) {
    const b1 = document.getElementById('bar-1');
    const b2 = document.getElementById('bar-2');
    const b3 = document.getElementById('bar-3');
    const b4 = document.getElementById('bar-4');
    const sText = document.getElementById('strength-text');

    const len = val.length;
    // Simple heuristic
    if (len === 0) {
      b1.className = 'rounded-full bg-surface-container-highest h-full';
      b2.className = 'rounded-full bg-surface-container-highest h-full';
      b3.className = 'rounded-full bg-surface-container-highest h-full';
      b4.className = 'rounded-full bg-surface-container-highest h-full';
      sText.textContent = 'Empty';
      sText.className = 'font-label-numeric-sm text-[10px] text-on-surface-variant';
    } else if (len < 6) {
      b1.className = 'rounded-full bg-error h-full';
      b2.className = 'rounded-full bg-surface-container-highest h-full';
      b3.className = 'rounded-full bg-surface-container-highest h-full';
      b4.className = 'rounded-full bg-surface-container-highest h-full';
      sText.textContent = 'Low (Vulnerable)';
      sText.className = 'font-label-numeric-sm text-[10px] text-error';
    } else if (len < 10) {
      b1.className = 'rounded-full bg-secondary-fixed h-full';
      b2.className = 'rounded-full bg-secondary-fixed h-full';
      b3.className = 'rounded-full bg-surface-container-highest h-full';
      b4.className = 'rounded-full bg-surface-container-highest h-full';
      sText.textContent = 'Moderate';
      sText.className = 'font-label-numeric-sm text-[10px] text-secondary-fixed';
    } else {
      b1.className = 'rounded-full bg-primary h-full';
      b2.className = 'rounded-full bg-primary h-full';
      b3.className = 'rounded-full bg-primary h-full';
      b4.className = 'rounded-full bg-primary h-full';
      sText.textContent = 'Institutional (High)';
      sText.className = 'font-label-numeric-sm text-[10px] text-primary';
    }
  }

  function simulateBiometricAuth() {
    const icon = document.getElementById('biometric-icon');
    const label = document.getElementById('biometric-label');
    const status = document.getElementById('biometric-status');

    icon.textContent = 'sync';
    icon.classList.add('animate-spin');
    label.textContent = 'Scanning Biometrics...';
    status.textContent = 'Communicating with Secure Enclave hardware';

    setTimeout(() => {
      icon.classList.remove('animate-spin');
      icon.textContent = 'check_circle';
      icon.classList.add('text-primary');
      label.textContent = 'Identity Confirmed';
      status.textContent = 'Zero-Knowledge challenge verified. Redirecting...';

      setTimeout(() => {
